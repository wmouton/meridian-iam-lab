{
  "displayName": "CA005 - High user risk requires secure password change (P2)",
  "state": "enabledForReportingButNotEnforced",
  "conditions": {
    "clientAppTypes": ["all"],
    "userRiskLevels": ["high"],
    "applications": { "includeApplications": ["All"] },
    "users": { "includeUsers": ["All"], "excludeGroups": ["{{BREAKGLASS_GROUP_ID}}"] }
  },
  "grantControls": { "operator": "AND", "builtInControls": ["mfa", "passwordChange"] }
}
